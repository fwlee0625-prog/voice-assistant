# 复制为 .env，服务启动时自动加载；外部环境变量优先。
MAIN_LLM_BASE_URL=http://127.0.0.1:8001/v1
MAIN_LLM_MODEL=qwen
MAIN_LLM_API_KEY=EMPTY
SECONDARY_LLM_BASE_URL=http://127.0.0.1:8001/v1
SECONDARY_LLM_MODEL=qwen
SECONDARY_LLM_API_KEY=EMPTY
ASR_ENDPOINT=http://127.0.0.1:8005/v1/audio/transcriptions
ASR_MODEL=qwen3-asr
ASR_LANGUAGE=zh
EMBEDDING_BASE_URL=http://127.0.0.1:8003/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_LOCAL_MODEL_PATH=
TTS_BACKEND=edge
TTS_COSYVOICE_ENDPOINT=http://127.0.0.1:8006
TTS_MELO_ENDPOINT=http://127.0.0.1:8007
# 可选：推荐、模拟、摆球以及“前往球台”依赖此地址。
BILLIARDS_CORE_URL=http://127.0.0.1:8999

# record 页面：腾讯云 TRTC v3 实时语音识别（SDK 密钥，仅后端读取）
TENCENT_TRTC_SDK_APP_ID=
TENCENT_TRTC_SECRET_KEY=
