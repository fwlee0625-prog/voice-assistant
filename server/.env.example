HOST=127.0.0.1
PORT=8020
# 精确匹配来源；生产环境配置页面的 HTTPS origin，多个使用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:5178,http://127.0.0.1:5178
# TRTC 应用 SDK 凭证（不是 CAM SecretId/SecretKey）
TENCENT_TRTC_SDK_APP_ID=
TENCENT_TRTC_SECRET_KEY=
# 可选离线增强；路径相对于 server/ 目录
ENHANCE_PYTHON=python3
SPEECH_ENHANCE_MODEL=./models/dpdfnet2_48khz_hr.onnx
SPEECH_ENHANCE_THREADS=2
SPEECH_ENHANCE_ATTENUATION_DB=0
FFMPEG_BIN=ffmpeg

# 可通过设置页面保存；密钥只在服务端使用
OPENAI_API_KEY=

# 小米 MiMo TTS，与模型密钥独立；也可以在设置弹框保存
MIMO_API_KEY=

# Smart Turn v3.2, standalone warm Python worker; default enabled
SMART_TURN_ENABLED=true
# Defaults to server/.venv/bin/python and server/models/smart-turn-v3.2-cpu.onnx
# SMART_TURN_PYTHON=
# SMART_TURN_MODEL=

# 本地模型服务用于衔接词选择；不可用时保持安静
MODEL_DECISION_ENABLED=true
MODEL_SERVICE_URL=http://127.0.0.1:8030
MODEL_DECISION_TIMEOUT_MS=600
